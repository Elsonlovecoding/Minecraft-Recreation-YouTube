# Dev-harness scaffolding only — the game itself has no npm dependencies.
# (Test harnesses symlink/install three@0.160.0 locally because the sandbox
# blocks unpkg.com; production loads the CDN via the importmap unchanged.)
# No trailing slash: the local node_modules may be a symlink, not a directory.
node_modules
# Dev-harness ESM shim for node unit tests (uncommitted; the game needs no npm)
package.json
package-lock.json
# Dev-harness browser entry (index.html with the importmap pointed at the
# local three copy — the sandbox blocks unpkg.com; production is untouched)
test.html
# Dev-harness mesher A/B snapshot (the pre-split Phase 16 chunks.js; the
# node suite regenerates it from git history and it must never ship)
src/world/chunks_head.js
